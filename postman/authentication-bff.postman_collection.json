			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"if (!pm.collectionVariables.get(\"runId\")) {",
					"    const runId = pm.variables.replaceIn(\"{{$randomUUID}}\")",
					"        .replace(/-/g, \"\")",
					"        .substring(0, 12);",
					"",
					"    pm.collectionVariables.set(\"runId\", runId);",
					"",
					"    pm.collectionVariables.set(\"user1Username\", `user1_${runId}`);",
					"    pm.collectionVariables.set(\"user1Password\", \"Password123!\");",
					"    pm.collectionVariables.set(\"user1Email\", `user1_${runId}@test.local`);",
					"",
					"    pm.collectionVariables.set(\"user2Username\", `user2_${runId}`);",
					"    pm.collectionVariables.set(\"user2Password\", \"Password123!\");",
					"    pm.collectionVariables.set(\"user2Email\", `user2_${runId}@test.local`);",
					"}"
				]
			}
