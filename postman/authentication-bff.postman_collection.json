		{
			"name": "01 - Register user1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log(\"REQUEST:\", pm.request.method, pm.request.url.toString());",
							"console.log(\"REQUEST BODY:\", pm.request.body.raw);",
							"console.log(\"RESPONSE:\", pm.response.code, pm.response.text());",
							"",
							"pm.test(\"User1 registered - 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"pm.expect(response.id).to.exist;",
							"pm.expect(response.username).to.eql(",
							"    pm.collectionVariables.get(\"user1Username\")",
							");",
							"",
							"pm.collectionVariables.set(\"user1Id\", response.id);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"{{user1Username}}\",\n  \"password\": \"{{user1Password}}\",\n  \"firstName\": \"User1\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{user1Email}}\",\n  \"phone\": \"+79990000001\"\n}",
