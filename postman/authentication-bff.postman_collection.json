							"    );",
							"",
							"    pm.expect(response.firstName).to.eql(\"UpdatedUser1\");",
							"    pm.expect(response.lastName).to.eql(\"UpdatedTest\");",
							"    pm.expect(response.email).to.eql(",
							"        `updated_${pm.collectionVariables.get(\"user1Email\")}`",
							"    );",
							"    pm.expect(response.phone).to.eql(\"+79991111111\");",
